# Text Anonymization Platform – Environment Configuration

# ─── LLM (required for /api/chat) ───────────────────────────────────────────
# Local development (LM Studio default):
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3-vl-8b

# Vercel / production (xAI Grok):
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=xai-...
# LLM_MODEL=grok-4.20-0309-non-reasoning

LLM_TIMEOUT_SECONDS=120

# ─── spaCy model size ────────────────────────────────────────────────────────
# "sm" (default) uses en_core_web_sm / de_core_news_sm – fits Vercel limits.
# "lg" uses en_core_web_lg / de_core_news_lg – higher accuracy, local only.
SPACY_MODEL_SIZE=sm

# ─── Database (optional) ─────────────────────────────────────────────────────
# When POSTGRES_URL is not set the app runs without usage tracking or auth.
# Get from Vercel Dashboard: Storage → Postgres → Connection String.
# POSTGRES_URL=postgresql://username:password@host:5432/database

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Get from Google Cloud Console: APIs & Services → Credentials.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ─── JWT secret (optional, only needed with OAuth) ───────────────────────────
# Generate: openssl rand -hex 32
# JWT_SECRET_KEY=your-secret-key-here-change-in-production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add your Vercel deployment URL here when deploying.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:8000

# ─── Usage limits ────────────────────────────────────────────────────────────
# Ignored when POSTGRES_URL is not set (unlimited in demo mode).
FREE_TIER_LIMIT=5
