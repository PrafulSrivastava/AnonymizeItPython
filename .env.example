# Text Anonymization Platform - Environment Configuration

# Database Configuration
# Get from Vercel Dashboard: Storage → Postgres → Connection String
# Or use local PostgreSQL: postgresql://postgres:postgres@127.0.0.1:5432/postgres
POSTGRES_URL=postgresql://username:password@host:5432/database

# Google OAuth Configuration
# Get from Google Cloud Console: APIs & Services → Credentials
# Create OAuth 2.0 Client ID for "Text Anonymization Platform"
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret Key
# Generate with: openssl rand -hex 32
# Used for session encryption and JWT tokens
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# Usage Limits
# Number of free requests for anonymous users before login required
FREE_TIER_LIMIT=5
